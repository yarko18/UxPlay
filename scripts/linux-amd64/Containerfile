FROM docker.io/library/debian:bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      binutils \
      ca-certificates \
      cmake \
      file \
      g++ \
      gcc \
      libglib2.0-dev \
      libgstreamer1.0-dev \
      libgstreamer-plugins-base1.0-dev \
      libplist-dev \
      libssl-dev \
      make \
      pkg-config \
 && rm -rf /var/lib/apt/lists/*
